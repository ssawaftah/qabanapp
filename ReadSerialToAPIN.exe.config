<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1" />
    </startup>
  <appSettings>
   
    <add key="F_SerialPortIndicatorBaudRate" value="9600"/>
    <add key="F_SerialPortIndicatorParity" value="2"/>
    <add key="F_SerialPortIndicatorDataBits" value="8"/>
    <add key="F_SerialPort" value="COM6"/>
    <add key="F_SerialInterval" value="1000"/>
  </appSettings>
</configuration>